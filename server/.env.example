# PostgreSQL 연결 문자열
# 형식: postgresql://[사용자]:[비밀번호]@[호스트]:[포트]/[DB이름]
#
# 로컬 예시 (사용자/비밀번호 직접 생성 시):
#   DATABASE_URL="postgresql://study_editor:your_password@localhost:5432/study_editor"
#   (psql에서: CREATE USER study_editor WITH PASSWORD 'your_password'; CREATE DATABASE study_editor OWNER study_editor;)
#
# macOS 기본 계정 (비밀번호 없음):
#   DATABASE_URL="postgresql://localhost:5432/study_editor"
#   (createdb study_editor 로 DB 생성)
#
# Docker: docker run -d -e POSTGRES_USER=study_editor -e POSTGRES_PASSWORD=your_password -e POSTGRES_DB=study_editor -p 5432:5432 postgres:16
DATABASE_URL="postgresql://localhost:5432/study_editor"

# JWT 서명용 시크릿
JWT_SECRET="your-jwt-secret-key-change-in-production"

# OAuth (선택)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
